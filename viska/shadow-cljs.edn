{:deps          {}
 :dev-http      {8080       ["resources/public" "classpath:public"]
                 8081       ["resources/portfolio/public" "classpath:public"]}
 :builds
 {:ui           {:target      :browser
                 :runtime     :browser
                 :dev         {:output-dir  "resources/public/ui/js/compiled"}
                 :asset-path  "js"
                 :modules     {:ui          {:init-fn viska.ui/main}}
                 }
  
  :app          {:target      :node-script
                 :output-to   "resources/public/app/js/compiled/app.js"
                 :main        viska.app/main}

  :portfolio    {:target            :browser
                 :modules           {:main                {:init-fn viska.scenes/main}}
                 :dev               {:output-dir          "resources/portfolio/public/js"}
                 :compiler-options  {:portfolio/enabled?  false}}}}